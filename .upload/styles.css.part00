:root{
  --bg:#070707;--panel:#111;--panel2:#181818;--muted:#aaa;--muted2:#737373;--text:#f5f5f5;--red:#e50914;--red2:#b20710;--line:#2a2a2a;--player-h:92px;
}
*{box-sizing:border-box}html{background:var(--bg);color-scheme:dark}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;overflow-x:hidden}button,input{font:inherit}button{color:inherit}.topbar{position:fixed;z-index:50;top:0;left:0;right:0;height:68px;padding:0 clamp(18px,4vw,56px);display:flex;align-items:center;gap:34px;background:linear-gradient(180deg,rgba(0,0,0,.92),rgba(0,0,0,.56) 70%,transparent);transition:background .25s,box-shadow .25s}.topbar.scrolled{background:rgba(7,7,7,.96);box-shadow:0 1px 0 rgba(255,255,255,.05);backdrop-filter:blur(14px)}.brand{border:0;background:none;padding:0;cursor:pointer;font-size:24px;font-weight:800;letter-spacing:-1.5px}.brand span{color:#fff}.brand b{color:var(--red)}.navlinks{display:flex;gap:22px}.navlink{border:0;background:none;padding:10px 0;color:#d1d1d1;font-size:14px;cursor:pointer}.navlink:hover,.navlink.active{color:#fff}.header-actions{margin-left:auto}.icon-btn{width:42px;height:42px;border:0;background:transparent;border-radius:50%;display:grid;place-items:center;cursor:pointer;font-size:28px}.icon-btn:hover{background:#ffffff12}.i-search{width:19px;height:19px;border:2px solid currentColor;border-radius:50%;display:block;position:relative}.i-search:after{content:"";position:absolute;width:8px;height:2px;background:currentColor;right:-6px;bottom:-3px;transform:rotate(45deg);border-radius:2px}.view{display:none;min-height:100vh;padding-bottom:calc(var(--player-h) + 48px)}.view.active{display:block}.hero{position:relative;min-height:min(76vh,760px);padding:150px clamp(18px,5vw,72px) 118px;display:flex;align-items:center;overflow:hidden;background:#151515}.hero-bg{position:absolute;inset:0;background-position:center 28%;background-size:cover;filter:saturate(.7);transform:scale(1.02)}.hero-bg:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#070707 0%,rgba(7,7,7,.88) 31%,rgba(7,7,7,.36) 62%,rgba(7,7,7,.45) 100%),linear-gradient(0deg,#070707 0%,transparent 40%)}.hero-content{position:relative;z-index:2;width:min(650px,86vw)}.eyebrow{font-size:12px;text-transform:uppercase;letter-spacing:.22em;font-weight:700;color:#dedede}.hero h1{font-size:clamp(44px,6.5vw,86px);line-height:.94;margin:14px 0 20px;letter-spacing:-.055em;text-wrap:balance}.hero-author{font-size:18px;color:#ddd;margin-bottom:15px}.hero-desc{font-size:clamp(15px,1.6vw,18px);line-height:1.55;color:#d1d1d1;max-width:620px;display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden}.hero-actions{display:flex;gap:12px;margin-top:28px}.btn{border:0;border-radius:5px;padding:12px 22px;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:10px}.btn.primary{background:#fff;color:#111}.btn.primary:hover{background:#ddd}.btn.secondary{background:#6d6d6eb3;color:#fff}.btn.secondary:hover{background:#6d6d6e}.btn.red{background:var(--red);color:#fff}.btn.red:hover{background:var(--red2)}.content-rows{position:relative;z-index:5;margin-top:-66px;padding:0 0 38px}.row{margin:0 0 32px}.row-head{display:flex;align-items:end;justify-content:space-between;padding:0 clamp(18px,4vw,56px);margin-bottom:11px}.row h2,.section-title{margin:0;font-size:clamp(19px,2.2vw,27px);letter-spacing:-.03em}.see-all{border:0;background:none;color:#aaa;cursor:pointer;font-size:13px}.see-all:hover{color:#fff}.rail-wrap{position:relative}.rail{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(150px,17vw);gap:8px;overflow-x:auto;padding:4px clamp(18px,4vw,56px) 10px;scroll-snap-type:x proximity;scrollbar-width:none}.rail::-webkit-scrollbar{display:none}.card{position:relative;aspect-ratio:2/3;border:0;background:#191919;border-radius:6px;overflow:hidden;cursor:pointer;scroll-snap-align:start;box-shadow:0 6px 24px rgba(0,0,0,.22);transition:transform .18s ease,box-shadow .18s ease}.card:hover{transform:scale(1.035);z-index:2;box-shadow:0 12px 36px rgba(0,0,0,.48)}.card img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:opacity .25s}.card .cover-fallback{position:absolute;inset:0;padding:16px;display:flex;flex-direction:column;justify-content:flex-end;background:linear-gradient(145deg,#292929,#0e0e0e)}.cover-fallback:before{content:"AUDIOBOX";position:absolute;top:13px;left:14px;font-size:8px;letter-spacing:.22em;color:#999}.cover-fallback strong{font-size:clamp(14px,1.5vw,22px);line-height:1.05;letter-spacing:-.04em}.cover-fallback span{margin-top:9px;color:#aaa;font-size:11px}.card-overlay{position:absolute;inset:auto 0 0;padding:42px 12px 12px;background:linear-gradient(transparent,rgba(0,0,0,.94));opacity:0;transition:opacity .18s}.card:hover .card-overlay{opacity:1}.card-overlay strong{font-size:13px;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.card-overlay span{font-size:11px;color:#aaa;display:block;margin-top:4px}.progress-line{position:absolute;left:8px;right:8px;bottom:7px;height:3px;background:#6668;border-radius:10px;overflow:hidden}.progress-line i{display:block;height:100%;background:var(--red)}.skeleton{animation:pulse 1.2s ease-in-out infinite alternate;background:#171717}.skeleton:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,transparent,#ffffff08,transparent);transform:translateX(-100%);animation:shimmer 1.5s infinite}@keyframes pulse{to{background:#202020}}@keyframes shimmer{to{transform:translateX(100%)}}.browse-hero,.list-hero{padding:128px clamp(18px,4vw,56px) 28px}.browse-hero h1,.list-hero h1{font-size:clamp(38px,6vw,70px);letter-spacing:-.055em;margin:0 0 12px}.subtext{color:#aaa;max-width:720px;line-height:1.6}.genre-pills{display:flex;flex-wrap:wrap;gap:9px;margin-top:24px}.pill{border:1px solid #3a3a3a;background:#151515;color:#ddd;padding:9px 14px;border-radius:999px;cursor:pointer;font-size:13px}.pill:hover,.pill.active{background:#fff;color:#111;border-color:#fff}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:18px 9px;padding:18px clamp(18px,4vw,56px) 50px}.grid .card{width:100%}.empty{padding:70px clamp(18px,4vw,56px);color:#aaa}.empty strong{display:block;color:#fff;font-size:28px;margin-bottom:8px}.search-panel{position:fixed;z-index:60;inset:0;background:rgba(7,7,7,.985);padding-top:86px;overflow:auto;opacity:0;pointer-events:none;transform:translateY(-10px);transition:opacity .18s,transform .18s}.search-panel.open{opacity:1;pointer-events:auto;transform:none}.search-box{display:flex;align-items:center;gap:15px;margin:0 auto;width:min(780px,calc(100vw - 36px));border-bottom:2px solid #fff;padding:10px 0}.search-box input{flex:1;border:0;outline:0;background:transparent;color:#fff;font-size:clamp(22px,4vw,38px);font-weight:600}.search-box input::placeholder{color:#666}.search-meta{width:min(780px,calc(100vw - 36px));margin:18px auto 8px;color:#888;font-size:13px}.search-panel .grid{padding-top:22px}.modal-backdrop{position:fixed;z-index:80;inset:0;background:#000b;display:flex;justify-content:center;align-items:flex-start;padding:5vh 12px calc(var(--player-h) + 24px);overflow:auto;opacity:0;pointer-events:none;transition:opacity .18s}.modal-backdrop.open{opacity:1;pointer-events:auto}.detail-modal{position:relative;width:min(950px,100%);background:#181818;border-radius:10px;overflow:hidden;box-shadow:0 28px 100px #000}.modal-close{position:absolute;z-index:5;right:16px;top:16px;width:38px;height:38px;border:0;border-radius:50%;background:#151515e6;color:#fff;font-size:28px;display:grid;place-items:center;cursor:pointer}.detail-hero{position:relative;min-height:380px;padding:72px 54px 46px;display:flex;align-items:flex-end;background:#222;overflow:hidden}.detail-hero-bg{position:absolute;inset:0;background-size:cover;background-position:center 25%;filter:blur(1px) saturate(.65);transform:scale(1.0