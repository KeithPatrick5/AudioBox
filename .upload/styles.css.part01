3)}.detail-hero:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#181818 0%,#181818dd 42%,#18181844),linear-gradient(0deg,#181818,transparent 58%)}.detail-hero-copy{position:relative;z-index:2;max-width:650px}.detail-hero h2{font-size:clamp(32px,5vw,60px);line-height:1;letter-spacing:-.05em;margin:0 0 10px}.detail-sub{color:#ccc;margin-bottom:18px}.detail-actions{display:flex;gap:10px;flex-wrap:wrap}.circle-btn{width:46px;height:46px;border-radius:50%;border:2px solid #777;background:#222a;display:grid;place-items:center;cursor:pointer;font-size:21px}.circle-btn.active{border-color:#fff}.detail-body{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(220px,.8fr);gap:38px;padding:28px 54px 48px}.detail-description{line-height:1.65;color:#ddd}.meta-list{font-size:13px;line-height:1.7;color:#aaa}.meta-list b{color:#ddd;font-weight:500}.chapters{padding:0 54px 54px}.chapters-head{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #333;padding-bottom:13px}.chapter-list{max-height:420px;overflow:auto}.chapter{width:100%;display:grid;grid-template-columns:42px 1fr auto;gap:13px;align-items:center;border:0;border-bottom:1px solid #2b2b2b;background:transparent;text-align:left;padding:15px 8px;cursor:pointer}.chapter:hover{background:#ffffff08}.chapter.playing{background:#ffffff0d}.chapter-num{color:#888;text-align:center}.chapter strong{font-size:14px}.chapter small{display:block;color:#888;margin-top:4px}.chapter-time{font-size:12px;color:#888}.author-box{padding:0 54px 54px}.author-card{display:grid;grid-template-columns:82px 1fr;gap:18px;border-top:1px solid #303030;padding-top:26px}.author-card img{width:82px;height:82px;object-fit:cover;border-radius:50%;background:#2b2b2b}.author-card h3{margin:0 0 8px}.author-card p{margin:0;color:#aaa;line-height:1.55;font-size:13px}.text-links{display:flex;gap:16px;flex-wrap:wrap;margin-top:17px}.text-link{color:#ddd;font-size:13px}.player{position:fixed;z-index:70;left:0;right:0;bottom:0;height:var(--player-h);background:rgba(20,20,20,.98);border-top:1px solid #2f2f2f;display:grid;grid-template-columns:minmax(230px,1fr) minmax(300px,1.6fr) minmax(200px,1fr);gap:20px;align-items:center;padding:10px 20px calc(10px + env(safe-area-inset-bottom));transform:translateY(105%);transition:transform .25s;box-shadow:0 -10px 40px #0007}.player.show{transform:none}.player-book{display:flex;align-items:center;min-width:0}.player-cover{width:55px;height:70px;border-radius:4px;overflow:hidden;background:#222;flex:none}.player-cover img{width:100%;height:100%;object-fit:cover}.player-meta{min-width:0;margin-left:12px}.player-meta strong,.player-meta span{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.player-meta strong{font-size:13px}.player-meta span{font-size:11px;color:#999;margin-top:5px}.player-center{display:flex;flex-direction:column;align-items:center;gap:7px}.player-controls{display:flex;align-items:center;gap:14px}.player-btn,.tool-btn{border:0;background:transparent;cursor:pointer;color:#ccc}.player-btn{font-size:18px}.play-main{width:36px;height:36px;border-radius:50%;border:0;background:#fff;color:#000;display:grid;place-items:center;cursor:pointer;padding-left:3px}.timeline{width:100%;display:grid;grid-template-columns:42px 1fr 42px;gap:7px;align-items:center;font-size:10px;color:#aaa}.timeline span:last-child{text-align:right}input[type=range]{accent-color:#fff;height:4px}.timeline input{width:100%;accent-color:var(--red)}.player-tools{display:flex;align-items:center;justify-content:flex-end;gap:8px}.tool-btn{font-size:12px;border:1px solid #444;border-radius:5px;padding:5px 7px;min-width:34px}.volume-icon{font-size:12px;transform:rotate(90deg);color:#aaa}.player-tools input{width:90px}.toast{position:fixed;z-index:100;left:50%;bottom:calc(var(--player-h) + 20px);transform:translate(-50%,20px);background:#fff;color:#111;border-radius:4px;padding:10px 15px;font-weight:600;font-size:13px;opacity:0;pointer-events:none;transition:.2s}.toast.show{opacity:1;transform:translate(-50%,0)}.error-box{margin:90px clamp(18px,4vw,56px);border:1px solid #3a3a3a;background:#131313;padding:30px;border-radius:8px}.error-box h2{margin-top:0}.error-box p{color:#aaa}.loader{width:28px;height:28px;border:3px solid #444;border-top-color:#fff;border-radius:50%;animation:spin .8s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}
@media(max-width:820px){:root{--player-h:116px}.navlinks{display:none}.topbar{height:58px}.hero{min-height:660px;padding-top:116px;align-items:flex-end}.hero-bg:after{background:linear-gradient(0deg,#070707 0%,rgba(7,7,7,.15) 65%,rgba(7,7,7,.4)),linear-gradient(90deg,#070707aa,transparent)}.content-rows{margin-top:-25px}.rail{grid-auto-columns:minmax(126px,36vw)}.detail-hero{min-height:340px;padding:70px 24px 32px}.detail-body{grid-template-columns:1fr;padding:22px 24px 34px;gap:18px}.chapters,.author-box{padding-left:24px;padding-right:24px}.player{grid-template-columns:1fr auto;height:auto;min-height:var(--player-h);gap:8px 12px;padding:8px 12px calc(8px + env(safe-area-inset-bottom))}.player-book{grid-column:1}.player-center{grid-column:1/-1;grid-row:2}.player-tools{grid-column:2;grid-row:1}.player-tools input,.volume-icon,#sleepBtn{display:none}.player-cover{width:40px;height:52px}.player-center{flex-direction:row}.player-controls{flex:none}.timeline{flex:1}.player-btn{display:none}.grid{grid-template-columns:repeat(auto-fill,minmax(118px,1fr));gap:14px 7px}.search-panel{padding-top:66px}}
@media(max-width:520px){.hero h1{font-size:46px}.hero-desc{-webkit-line-clamp:3}.btn{padding:11px 16px}.detail-hero h2{font-size:38px}.detail-modal{border-radius:0}.modal-backdrop{padding:0 0 var(--player-h)}.modal-close{position:fixed;top:12px;right:12px}.chapter{grid-template-columns:34px 1fr}.chapter-time{display:none}.author-card{grid-template-columns:60px 1fr}.author-card img{width:60px;height:60px}.search-box input{font-size:24px}}
